# Copy to .env. Without an LLM key the app still runs — every LLM call degrades
# to a deterministic fallback and the degradation is visible in /audit/llm-calls.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Take the *Session pooler* (port 5432) unless you specifically need the
# transaction pooler on 6543 — both work, session pooler has fewer edge cases.
# URL-encode the password if it contains @ : / ? # or & (%40 %3A %2F %3F %23 %26).
# The `postgresql://` prefix and sslmode are fixed up automatically, so paste
# the URI exactly as the dashboard gives it.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Local Postgres instead:
# DATABASE_URL=postgresql+psycopg://localhost/budgetx

API_BASE=http://localhost:8000
